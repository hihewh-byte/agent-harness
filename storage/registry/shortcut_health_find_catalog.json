{
  "schema_version": "shortcut_health_find_catalog_v1",
  "updated": "2026-09-15",
  "rule": "shortcut_find_type 只能是 iOS 快捷指令「查找健康样本」选择器里的字面量，从真机抄录。禁止用 HealthKit SDK 名、健康 App 浏览页英文标题、权限面板别名去猜。status 不是 device_verified 的行禁止写入任何捷径。picker_search_probes 只供真机英文选择器搜索，不得复制进 shortcut_find_type、不得生成捷径。新增或勾选指标时先查本表，再 bump shortcut_pack_version。",
  "never_use_find_labels": [
    "Active Energy",
    "Blood Oxygen",
    "Apple Sleeping Wrist Temperature",
    "Cardio Fitness",
    "Step Count",
    "Sleep Analysis"
