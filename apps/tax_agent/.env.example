# Tax Agent — MacBook Air M4 16GB 推荐配置
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 默认对话模型（已安装）
TAX_AGENT_MODEL=qwen2.5:7b-instruct
# 复杂推演时改为: TAX_AGENT_MODEL=deepseek-r1:14b

TAX_AGENT_LLM_ENABLED=1
TAX_AGENT_LLM_TIMEOUT_SECONDS=120
TAX_AGENT_LOW_RAM=1
TAX_AGENT_UNLOAD_HEAVY_MODELS=1

# SQLite（默认 tax_agent/.data/tax_agent.db）
# TAX_AGENT_DB=
# TAX_AGENT_MEMORY=1

# 规则自动更新（可信 Feed / inbox，见 docs/rule-auto-update-v1.md）
# TAX_AGENT_RULES_FEED_URL=https://internal.example.com/tax-rules/feed.json
# TAX_AGENT_RULES_FEED_TOKEN=
# TAX_AGENT_AUTO_PUBLISH=1
# TAX_AGENT_RULES_AUTO_SYNC_INTERVAL_SECONDS=3600
# TAX_AGENT_RULES_SYNC_ON_STARTUP=1
# TAX_AGENT_RULES_ADMIN_TOKEN=change-me-in-production
# TAX_AGENT_RULES_WEBHOOK_SECRET=change-me-for-github-webhook
# TAX_AGENT_RULES_WEBHOOK_BRANCH=main

# 发布后 72h 监控与自动回滚（见 docs/rule-versioning-pipeline-v1.md §4.3）
# TAX_AGENT_RULES_MONITOR_HOURS=72
# TAX_AGENT_RULES_ROLLBACK_ERROR_RATE=0.01
# TAX_AGENT_RULES_ROLLBACK_MIN_SAMPLES=5
# TAX_AGENT_RULES_AUTO_ROLLBACK=1
# TAX_AGENT_RULES_MONITOR_INTERVAL_SECONDS=3600

# 专家复核工单 SLA（默认 48h，80% 预警 + 超时 Webhook）
# TAX_AGENT_REVIEW_SLA_INTERVAL_SECONDS=900
# TAX_AGENT_REVIEW_SLA_WEBHOOK_URL=https://hooks.example.com/tax-review-sla
# TAX_AGENT_REVIEW_SLA_WEBHOOK_TOKEN=

# API 鉴权 RBAC（user / tax_expert / tax_rule_admin）
# TAX_AGENT_AUTH_ENABLED=1
# TAX_AGENT_USER_TOKEN=change-me-user
# TAX_AGENT_EXPERT_TOKEN=change-me-expert
# 或使用 JSON：TAX_AGENT_AUTH_TOKENS={"user-secret":"user","expert-secret":"tax_expert","admin-secret":"tax_rule_admin"}
